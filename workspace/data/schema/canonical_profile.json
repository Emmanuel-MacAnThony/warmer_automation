{
  "_meta": {
    "version": "2.0",
    "description": "Canonical LinkedIn profile fields. One entry per data point as scraped. The agent resolves data type and shape at write time based on target Airtable field type and available choices.",
    "groups": ["identity", "location", "contact", "current_role", "career", "education", "social", "network", "metadata"]
  },

  "fields": [

    {
      "key": "linkedin_url",
      "label": "LinkedIn URL",
      "group": "identity",
      "description": "Profile URL",
      "source_path": "profile_url",
      "example": "https://linkedin.com/in/keeganmcnamara/"
    },
    {
      "key": "full_name",
      "label": "Full Name",
      "group": "identity",
      "description": "Full name as shown on LinkedIn",
      "source_path": "full_name",
      "example": "Keegan McNamara"
    },
    {
      "key": "first_name",
      "label": "First Name",
      "group": "identity",
      "source_path": "first_name",
      "example": "Keegan"
    },
    {
      "key": "last_name",
      "label": "Last Name",
      "group": "identity",
      "source_path": "last_name",
      "example": "McNamara"
    },
    {
      "key": "headline",
      "label": "Headline",
      "group": "identity",
      "description": "LinkedIn tagline / headline",
      "source_path": "headline",
      "example": "Engineering & Design"
    },
    {
      "key": "summary",
      "label": "About / Summary",
      "group": "identity",
      "description": "LinkedIn About section",
      "source_path": "summary",
      "example": "I build products at the intersection of..."
    },
    {
      "key": "profile_image",
      "label": "Profile Image URL",
      "group": "identity",
      "source_path": "raw_data.profilePicHighQuality",
      "example": "https://media.licdn.com/..."
    },

    {
      "key": "location",
      "label": "Location",
      "group": "location",
      "description": "Full location string",
      "source_path": "raw_data.addressWithCountry",
      "example": "San Francisco, California, United States"
    },
    {
      "key": "city",
      "label": "City",
      "group": "location",
      "source_path": "city",
      "example": "San Francisco"
    },
    {
      "key": "state",
      "label": "State / Region",
      "group": "location",
      "source_path": "state",
      "example": "California"
    },
    {
      "key": "country",
      "label": "Country",
      "group": "location",
      "source_path": "raw_data.addressCountryOnly",
      "example": "United States"
    },

    {
      "key": "email",
      "label": "Email",
      "group": "contact",
      "source_path": "email",
      "example": "keegan@example.com"
    },
    {
      "key": "phone",
      "label": "Phone",
      "group": "contact",
      "source_path": "phone",
      "example": "+1 555 000 0000"
    },
    {
      "key": "twitter",
      "label": "Twitter / X",
      "group": "contact",
      "source_path": "twitter",
      "example": "@keeganmc"
    },
    {
      "key": "website",
      "label": "Website",
      "group": "contact",
      "source_path": "websites",
      "description": "Personal or company website(s)",
      "example": ["https://keegan.com"]
    },

    {
      "key": "job_title",
      "label": "Job Title",
      "group": "current_role",
      "description": "Current or most recent job title",
      "source_path": "raw_data.jobTitle",
      "example": "Founder"
    },
    {
      "key": "company_name",
      "label": "Company Name",
      "group": "current_role",
      "source_path": "raw_data.companyName",
      "example": "Mythic Computer Co."
    },
    {
      "key": "company_industry",
      "label": "Company Industry",
      "group": "current_role",
      "source_path": "raw_data.companyIndustry",
      "example": "Software Development"
    },
    {
      "key": "company_website",
      "label": "Company Website",
      "group": "current_role",
      "source_path": "raw_data.companyWebsite",
      "example": "https://mythiccomputer.co"
    },
    {
      "key": "company_linkedin",
      "label": "Company LinkedIn",
      "group": "current_role",
      "source_path": "raw_data.companyLinkedin",
      "example": "https://linkedin.com/company/mythic-computer-co/"
    },
    {
      "key": "company_size",
      "label": "Company Size",
      "group": "current_role",
      "source_path": "raw_data.companySize",
      "example": "51-200"
    },
    {
      "key": "job_started",
      "label": "Job Start Year",
      "group": "current_role",
      "source_path": "raw_data.jobStartedOn",
      "example": "2023"
    },
    {
      "key": "job_location",
      "label": "Job Location",
      "group": "current_role",
      "source_path": "raw_data.jobLocation",
      "example": "Los Angeles, California, United States"
    },
    {
      "key": "currently_employed",
      "label": "Currently Employed",
      "group": "current_role",
      "source_path": "raw_data.isCurrentlyEmployed",
      "example": false
    },

    {
      "key": "experiences",
      "label": "Experiences",
      "group": "career",
      "description": "All roles. Each entry: companyName, title, jobStartedOn, jobEndedOn, jobLocation, jobStillWorking, employmentType, companyIndustry, companyWebsite, companySize.",
      "source_path": "raw_data.experiences",
      "example": [
        { "companyName": "Mythic Computer Co.", "title": "Founder", "jobStartedOn": "2023", "jobEndedOn": "2025", "employmentType": "Full-time" }
      ]
    },
    {
      "key": "total_experience_years",
      "label": "Total Experience (Years)",
      "group": "career",
      "source_path": "raw_data.totalExperienceYears",
      "example": 7
    },
    {
      "key": "career_count",
      "label": "Number of Roles",
      "group": "career",
      "source_path": "raw_data.experiencesCount",
      "example": 6
    },
    {
      "key": "first_role_year",
      "label": "First Role Year",
      "group": "career",
      "source_path": "raw_data.firstRoleYear",
      "example": 2017
    },

    {
      "key": "educations",
      "label": "Educations",
      "group": "education",
      "description": "All education entries. Each: title (institution), subtitle (degree + field), grade, period.startedOn.year, period.endedOn.year.",
      "source_path": "raw_data.educations",
      "example": [
        { "title": "University of Colorado Boulder", "subtitle": "Bachelor of Arts - BA, Mathematics", "period": { "startedOn": { "year": 2016 }, "endedOn": { "year": 2019 } } }
      ]
    },
    {
      "key": "alma_mater",
      "label": "Alma Mater",
      "group": "education",
      "description": "Primary institution name (first education entry)",
      "source_path": "raw_data.educations[0].title",
      "example": "University of Colorado Boulder"
    },
    {
      "key": "degree",
      "label": "Degree",
      "group": "education",
      "description": "Primary degree and field (first education entry)",
      "source_path": "raw_data.educations[0].subtitle",
      "example": "Bachelor of Arts - BA, Mathematics"
    },

    {
      "key": "connections",
      "label": "Connections",
      "group": "social",
      "source_path": "connections",
      "example": 1052
    },
    {
      "key": "followers",
      "label": "Followers",
      "group": "social",
      "source_path": "followers",
      "example": 1133
    },
    {
      "key": "is_premium",
      "label": "LinkedIn Premium",
      "group": "social",
      "source_path": "raw_data.isPremium",
      "example": false
    },
    {
      "key": "is_open_to_work",
      "label": "Open to Work",
      "group": "social",
      "source_path": "raw_data.isJobSeeker",
      "example": false
    },
    {
      "key": "is_creator",
      "label": "Creator Mode",
      "group": "social",
      "source_path": "raw_data.isCreator",
      "example": false
    },
    {
      "key": "recommendations_received",
      "label": "Recommendations Received",
      "group": "social",
      "source_path": "raw_data.totalRecommendationsReceived",
      "example": 0
    },
    {
      "key": "skills",
      "label": "Skills",
      "group": "social",
      "description": "Array of skill strings",
      "source_path": "raw_data.skills",
      "example": ["Python", "Machine Learning", "Product Management"]
    },
    {
      "key": "languages",
      "label": "Languages",
      "group": "social",
      "description": "Each entry: name, proficiency",
      "source_path": "languages",
      "example": [{ "name": "English", "proficiency": "Native or bilingual proficiency" }]
    },
    {
      "key": "publications",
      "label": "Publications",
      "group": "social",
      "description": "Each entry: title, source, summary, url",
      "source_path": "raw_data.publications",
      "example": [{ "title": "Virtual Addiction Is Not an Individual Problem", "source": "Palladium Magazine", "url": "https://..." }]
    },
    {
      "key": "certifications",
      "label": "Certifications",
      "group": "social",
      "source_path": "raw_data.licenseAndCertificates",
      "example": []
    },

    {
      "key": "similar_profiles",
      "label": "Similar Profiles (Network)",
      "group": "network",
      "description": "People Also Viewed. Each entry: first_name, last_name, headline, url, follower_count, premium.",
      "source_path": "raw_data.peopleAlsoViewed",
      "example": [{ "first_name": "Joel", "last_name": "Lewenstein", "headline": "Design @ Anthropic", "follower_count": 4238 }]
    },
    {
      "key": "similar_profiles_count",
      "label": "Similar Profiles Count",
      "group": "network",
      "source_path": "raw_data.peopleAlsoViewed.length",
      "example": 25
    },

    {
      "key": "linkedin_id",
      "label": "LinkedIn ID",
      "group": "metadata",
      "source_path": "raw_data.linkedinId",
      "example": "256161512"
    },
    {
      "key": "linkedin_urn",
      "label": "LinkedIn URN",
      "group": "metadata",
      "source_path": "raw_data.urn",
      "example": "ACoAAA9EtugBBNNRzGE89HAK8MrEkeoc03Y9VsI"
    },
    {
      "key": "enriched_at",
      "label": "Enriched At",
      "group": "metadata",
      "description": "Timestamp when this record was last enriched",
      "source_path": "_system.enriched_at",
      "example": "2026-02-16T10:00:00Z"
    },
    {
      "key": "enrichment_source",
      "label": "Enrichment Source",
      "group": "metadata",
      "source_path": "_system.enrichment_source",
      "example": "linkedin_scrape_v1"
    }

  ]
}
