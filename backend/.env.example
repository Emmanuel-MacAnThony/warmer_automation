# ── Airtable ──────────────────────────────────────────────────────────────────
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=Contacts
AIRTABLE_VIEW_NAME=            # optional — leave blank to use all records

# ── Database (Neon / Postgres) ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
# gpt-4o-mini is ~20x cheaper and sufficient for extraction. Use gpt-4o only if
# you need higher reasoning quality (e.g. complex field mapping on messy data).
OPENAI_MODEL=gpt-4o-mini

# ── Apify ─────────────────────────────────────────────────────────────────────
APIFY_API_TOKEN=apify_api_...
# Comma-separated list of tokens for multi-account load balancing.
# Falls back to APIFY_API_TOKEN if not set.
APIFY_TOKENS=apify_api_token1,apify_api_token2
# Max concurrent Apify runs per token. Keep at 2–3 to avoid rate limits.
# Higher values burn credits faster when retries kick in.
APIFY_CONCURRENCY_PER_TOKEN=4

# ── Serper.dev (LinkedIn URL search + optional news) ─────────────────────────
SERPAPI_API_KEY=your_serper_dev_key_here

# ── Enrichment pipeline ───────────────────────────────────────────────────────
BATCH_SIZE=10                  # records per Airtable batch fetch
BATCH_OUTPUT_DIR=./data/batches
MAX_LINKEDIN_RESULTS=3         # SERP candidates to rank per contact
MATCH_CONFIDENCE_THRESHOLD=0.6 # min LLM confidence to accept a LinkedIn URL match
DRY_RUN=false                  # true = analyse but do not write to Airtable

# ── Cost controls ─────────────────────────────────────────────────────────────
# Skip contacts that already have trajectory_tag set — prevents re-scraping on re-runs.
SKIP_ALREADY_ENRICHED=true
# Enable Twitter/X scraping (extra Apify call per contact — apidojo/tweet-scraper).
# Off by default. Turn on only when you specifically need tweet signals.
ENRICH_TWITTER=false
# Enable Google News search per contact (uses Serper.dev credits).
# Off by default. Useful for high-value Tier 1 targets, not bulk runs.
ENRICH_NEWS=false

# ── Email sending (outreach batch runner) ─────────────────────────────────────
# Which provider to use: gmail | smtp | resend
EMAIL_PROVIDER=gmail
# Set true to log sends without delivering (dev / CI)
EMAIL_DRY_RUN=false

# Gmail OAuth — required when EMAIL_PROVIDER=gmail
# GOOGLE_CREDENTIALS_JSON accepts EITHER:
#   (local dev)  a path to the OAuth client JSON file, e.g. google_credentials.json
#   (production) the JSON content itself on one line — set as an env var, NOT a file.
# The file is gitignored; never commit it. In production paste the JSON as the value.
GOOGLE_CREDENTIALS_JSON=google_credentials.json
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# SMTP provider settings — required when EMAIL_PROVIDER=smtp
# Workspace relay → host=smtp-relay.gmail.com, port=587 (sends as your domain, up to 10k/day)
# SendGrid → host=smtp.sendgrid.net, port=587, user=apikey, pass=<sendgrid_api_key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Resend provider — required when EMAIL_PROVIDER=resend (free: 3,000/mo, 100/day)
# Custom-domain / Workspace only. The from-address domain MUST be verified in Resend
# (DKIM/SPF). You cannot send "from" an @gmail.com address through Resend — Gmail's
# DMARC policy rejects it. For personal Gmail, use EMAIL_PROVIDER=gmail instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
